{
  "screen": { "width": 1920, "height": 720 },
  "units_per_mm": 8,

  "movement": {
    "max_chunk_units": 100,
    "chunk_pause_ms": 50,
    "settle_ms": 300,
    "screen_load_ms": 800
  },

  "scroll": { "ticks": 800, "settle_ms": 500 },

  "screens": {
    "main": {
      "targets": {
        "home":         { "x": 1850, "y": 88 },
        "applications": { "x": 1850, "y": 208 },
        "ac_control":   { "x": 1850, "y": 512 },
        "bt_mobile":    { "x": 1850, "y": 632 }
      }
    },

    "applications": {
      "enter": { "target": "applications", "parent": "main" },
      "targets": {
        "vehicle_settings": { "x": 720,  "y": 528 },
        "carplay":          { "x": 1500, "y": 528, "terminal": true }
      }
    },

    "vehicle_settings": {
      "enter": { "target": "vehicle_settings", "parent": "applications" },
      "targets": {
        "settings_list": { "x": 1635, "y": 188 }
      }
    },

    "settings_list": {
      "enter": { "target": "settings_list", "parent": "vehicle_settings" },
      "scrollable": true,
      "views": {
        "bottom": {
          "targets": {
            "intelligent_driving": { "x": 1635, "y": 513 }
          }
        },
        "top": {
          "targets": {
            "in_car":  { "x": 1635, "y": 318 },
            "driving": { "x": 1635, "y": 628 }
          }
        }
      }
    },

    "intelligent_driving": {
      "enter": { "target": "intelligent_driving", "parent": "settings_list", "parent_view": "bottom" },
      "targets": {
        "lane_assist": { "x": 995, "y": 163 }
      }
    },

    "lane_assist": {
      "enter": { "target": "lane_assist", "parent": "intelligent_driving" },
      "targets": {
        "elk_toggle": { "x": 1355, "y": 553 }
      }
    },

    "in_car": {
      "enter": { "target": "in_car", "parent": "settings_list", "parent_view": "top" },
      "targets": {
        "cabin_tab":       { "x": 635,  "y": 168, "sets_view": "cabin" },
        "driver_seat_tab": { "x": 1275, "y": 168, "sets_view": "driver_seat" }
      },
      "views": {
        "cabin": {
          "switch": "cabin_tab",
          "targets": {
            "dms_toggle":  { "x": 1371, "y": 268 },
            "dms_confirm": { "x": 1091, "y": 558, "wait_before": 4 }
          }
        },
        "driver_seat": {
          "switch": "driver_seat_tab",
          "targets": {
            "seat_pos_1": { "x": 895,  "y": 668 },
            "seat_pos_2": { "x": 1100, "y": 668 },
            "seat_pos_3": { "x": 1300, "y": 668 }
          }
        }
      }
    },

    "driving": {
      "enter": { "target": "driving", "parent": "settings_list", "parent_view": "top" },
      "targets": {
        "eco_toggle":   { "x": 1355, "y": 388 },
        "single_pedal": { "x": 1355, "y": 508 }
      }
    },
    
    "ac_control": {
      "enter": { "target": "ac_control", "parent": "main" },
      "views": {
        "seat": {
          "targets": {
            "ac_seat": { "x": 1660, "y": 450 }
          },
        },
        "front": {
          "targets": {
            "ac_front": { "x": 1660, "y": 340 }
          }
        }
      }
    },
    
    "ac_front": {
      "enter": { "target": "ac_front", "parent": "ac_control", "parent_view": "front" },
      "targets": {
        "ac_front_defrost": { "x": 350, "y": 640 },
        "ac_rear_defrost":  { "x": 490, "y": 640 },
        "ac_seat_pass":     { "x": 640, "y": 640 },
        "ac_down":          { "x": 700, "y": 640 },
        "ac_up":            { "x": 1080, "y": 640 },
        "ac_seat_driv":     { "x": 1140, "y": 640 },
        "ac_recycle":       { "x": 1290, "y": 640 }
      }
    },
    
    "ac_seat_pass": {
      "enter": { "target": "ac_seat_pass", "parent": "ac_front" },
      "targets": {
        "sp_heat3":     { "x": 350, "y": 640 },
        "sp_heat2":     { "x": 450, "y": 640 },
        "sp_heat1":     { "x": 545, "y": 640 },
        "sp_off":       { "x": 640, "y": 640 },
        "sp_cool1":     { "x": 735, "y": 640 },
        "sp_cool2":     { "x": 830, "y": 640 },
        "sp_cool3":     { "x": 930, "y": 640 }
      }
    },
    
    "ac_seat_driv": {
      "enter": { "target": "ac_seat_driv", "parent": "ac_front" },
      "targets": {
        "sd_heat3":     { "x": 850, "y": 640 },
        "sd_heat2":     { "x": 940, "y": 640 },
        "sd_heat1":     { "x": 1040, "y": 640 },
        "sd_off":       { "x": 1140 "y": 640 },
        "sd_cool1":     { "x": 1240, "y": 640 },
        "sd_cool2":     { "x": 1340, "y": 640 },
        "sd_cool3":     { "x": 1450, "y": 640 }
      }
    },
    
    "ac_seat": {
      "enter": { "target": "ac_seat", "parent": "ac_control", "parent_view": "seat" },
      "targets": {
        "sp_massage":     { "x": 580, "y": 490, "sets_view": "sp_mass_toggle" },
        "sd_massage":     { "x": 1430, "y": 490, "sets_view": "sd_mass_toggle" }
      },
      "views": {
        "sp_mass_toggle": {
          "switch": "sp_massage",
          "targets": {
            "sp_mass_low":     { "x": 250, "y": 575 },
            "sp_mass_high":    { "x": 510, "y": 575 }
          }
        },
        "sd_mass_toggle": {
          "switch": "sd_massage",
          "targets": {
            "sd_mass_low":     { "x": 1090, "y": 575 },
            "sd_mass_high":    { "x": 1350, "y": 575 }
          }
        }
      }
    }
  }
}
